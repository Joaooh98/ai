#!/usr/bin/env bash
# Busca um segredo no Vault e executa um comando com ele no ambiente.
#
#   secrets/with-secrets <caminho> -- <comando> [args...]
#   secrets/with-secrets hostinger -- npx --package=hostinger-api-mcp@latest hostinger-vps-mcp
#
# ---------------------------------------------------------------------------
# É a peça central do desenho. O valor do segredo:
#
#   - não existe em arquivo nenhum (nem .env, nem .mcp.json, nem ~/.claude.json);
#   - entra SÓ no ambiente do processo que este script executa;
#   - nunca entra no ambiente da sessão do Claude Code, e portanto nenhum
#     comando Bash do agente o herda — um `printenv` do agente não o encontra.
#
# É por isso que a lista de restrição é curta: não adianta bloquear a leitura de
# um arquivo que não existe.
# ---------------------------------------------------------------------------
#
# Não existe flag de verbose nem de debug aqui, e isso é decisão de segurança,
# não esquecimento: toda saída extra é uma chance de imprimir o valor. Nenhum
# caminho de erro deste script ecoa o segredo — só o caminho no vault.

set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=/dev/null
. "$SELF_DIR/_lib.sh"

caminho="${1:-}"
shift 2>/dev/null || true
if [ "${1:-}" = "--" ]; then shift; fi

if [ -z "$caminho" ] || [ $# -eq 0 ]; then
  echo "uso: with-secrets <caminho> -- <comando> [args...]" >&2
  exit 2
fi

precisa curl
precisa jq

# O `|| exit 1` não é redundante: `exit` dentro de `$( )` encerra apenas o
# subshell, então sem isto um token ausente seguiria adiante como string vazia
# e o erro só apareceria depois, disfarçado de "caminho não existe no vault".
token="$(ler_token)" || exit 1
[ -n "$token" ] || exit 1

resposta="$(api GET "/v1/$KV_MOUNT/data/$caminho" '' "$token" 2>/dev/null)"
unset token

if [ -z "$resposta" ]; then
  cat >&2 <<EOF
não consegui ler '$KV_MOUNT/$caminho' do Vault.

  vault lacrado?     secrets/vault-unseal
  vault de pé?       docker compose -f secrets/compose.yml ps
  caminho existe?    secrets/vault-put $caminho <CHAVE>
EOF
  exit 1
fi

# Monta o vetor de ambiente como pares NOME=valor e usa `env` para injetar.
# `env NOME=valor comando` não passa o valor por interpretação do shell, então
# aspas, cifrão e quebra de linha no segredo não viram execução de código.
mapfile -t pares < <(printf '%s' "$resposta" | jq -r '.data.data | to_entries[] | "\(.key)=\(.value)"' 2>/dev/null)
unset resposta

if [ ${#pares[@]} -eq 0 ]; then
  echo "'$KV_MOUNT/$caminho' existe mas não tem nenhuma chave." >&2
  exit 1
fi

# exec substitui este processo: nada fica pendurado segurando o segredo, e o
# comando herda o ambiente sem um shell intermediário no meio.
exec env "${pares[@]}" "$@"
