#!/usr/bin/env bash
# Guarda um segredo no Vault, digitado sem eco.
#
#   secrets/vault-put <caminho> <CHAVE> [CHAVE...]
#   secrets/vault-put hostinger APITOKEN
#
# O valor é pedido com o eco desligado e nunca aparece na tela nem no histórico
# do shell — que é o motivo de existir este script em vez de um `curl -d` na
# linha de comando, onde o segredo ficaria no `~/.bash_history` e visível para
# qualquer `ps` durante a execução.
#
# Escrever exige o root token, lido do pass. O token que fica no disco para o
# wrapper é só de leitura e não serve aqui — de propósito.

set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=/dev/null
. "$SELF_DIR/_lib.sh"

precisa curl
precisa jq
precisa pass

caminho="${1:-}"; shift 2>/dev/null
if [ -z "$caminho" ] || [ $# -eq 0 ]; then
  echo "uso: secrets/vault-put <caminho> <CHAVE> [CHAVE...]" >&2
  echo "ex:  secrets/vault-put hostinger APITOKEN" >&2
  exit 2
fi

exigir_vault_de_pe
if vault_selado; then
  echo "o Vault está lacrado. Rode: secrets/vault-unseal" >&2
  exit 1
fi

root="$(pass show "$PASS_ENTRY" 2>/dev/null | jq -r '.root_token // empty')"
[ -n "$root" ] || { echo "não consegui ler o root token do pass ('$PASS_ENTRY')." >&2; exit 1; }

# Monta o JSON com jq para que qualquer caractere no valor — aspas, barra,
# cifrão — seja escapado corretamente em vez de quebrar o corpo da requisição.
dados='{}'
for chave in "$@"; do
  printf 'valor de %s (não aparece na tela): ' "$chave" >&2
  valor=""
  if ! read -rs valor < /dev/tty 2>/dev/null; then
    read -rs valor || valor=""
  fi
  printf '\n' >&2
  if [ -z "$valor" ]; then
    echo "valor vazio para $chave — abortando sem gravar nada." >&2
    exit 1
  fi
  dados="$(jq -n --argjson d "$dados" --arg k "$chave" --arg v "$valor" '$d + {($k): $v}')"
  unset valor
done

corpo="$(jq -n --argjson d "$dados" '{data: $d}')"
unset dados

if api PUT "/v1/$KV_MOUNT/data/$caminho" "$corpo" "$root" >/dev/null 2>&1; then
  unset corpo root
  echo "gravado em $KV_MOUNT/$caminho"
  echo
  echo "Usar sem que o valor passe pelo contexto do modelo:"
  echo "  secrets/with-secrets $caminho -- <comando>"
else
  unset corpo root
  echo "falha ao gravar em $KV_MOUNT/$caminho" >&2
  exit 1
fi
