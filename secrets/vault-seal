#!/usr/bin/env bash
# Lacra o Vault. Use quando sair da máquina.
#
#   secrets/vault-seal
#
# Vault destravado é vault legível por quem tiver o token. Lacrar devolve o
# cofre ao estado em que nem o token serve — só as chaves de unseal reabrem.
# Depois de lacrar, os servidores MCP que dependem do wrapper param de subir
# até você rodar secrets/vault-unseal de novo. Isso é o comportamento correto,
# não um defeito.

set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=/dev/null
. "$SELF_DIR/_lib.sh"

precisa curl
precisa jq
precisa pass

exigir_vault_de_pe

if vault_selado; then
  echo "já estava lacrado."
  exit 0
fi

root="$(pass show "$PASS_ENTRY" 2>/dev/null | jq -r '.root_token // empty')"
[ -n "$root" ] || { echo "não consegui ler o root token do pass ('$PASS_ENTRY')." >&2; exit 1; }

api PUT /v1/sys/seal '' "$root" >/dev/null 2>&1
unset root

if vault_selado; then
  echo "lacrado. Para reabrir: secrets/vault-unseal"
else
  echo "o Vault continua destravado — o pedido de lacre não teve efeito." >&2
  exit 1
fi
