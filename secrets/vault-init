#!/usr/bin/env bash
# Inicializa o Vault UMA vez e guarda as chaves no `pass`, cifradas pela sua
# chave GPG. Roda uma vez na vida deste vault.
#
#   secrets/vault-init
#
# ---------------------------------------------------------------------------
# NUNCA imprime chave de unseal nem root token. Se imprimisse, as chaves do
# cofre cairiam no terminal, no scrollback e no contexto do modelo que rodou o
# comando — o cofre nasceria comprometido. Por isso a saída do `sys/init` vai
# direto para arquivo com permissão 600 e de lá para o `pass`.
# ---------------------------------------------------------------------------
#
# Ordem deliberada: grava em arquivo temporário protegido ANTES de tentar o
# `pass`, e só apaga depois de confirmar que dá para ler de volta. Se o `pass`
# falhar no meio (chave GPG errada, pinentry cancelado) e o script já tivesse
# jogado a saída fora, o vault estaria inicializado e sem ninguém no mundo capaz
# de destravá-lo. Perder chave de unseal é perder o cofre, sem recurso.

set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=/dev/null
. "$SELF_DIR/_lib.sh"

precisa curl
precisa jq
precisa pass "instale com: sudo apt install pass"
precisa gpg

exigir_vault_de_pe

if vault_inicializado; then
  cat >&2 <<EOF
este Vault JÁ está inicializado — nada a fazer.

  Se ele está lacrado:            secrets/vault-unseal
  Se você perdeu as chaves, não há recuperação: o jeito é destruir o volume
  e começar de novo, perdendo todo segredo guardado:
      docker compose -f secrets/compose.yml down
      docker volume rm ai-secrets-vault-data
EOF
  exit 1
fi

# O pass precisa de uma chave GPG utilizável. Descobrir isso agora é melhor que
# descobrir com o vault já inicializado e a saída na mão.
if ! pass ls >/dev/null 2>&1; then
  echo "o 'pass' não está inicializado. Rode: pass init <sua-chave-gpg>" >&2
  exit 1
fi

if pass show "$PASS_ENTRY" >/dev/null 2>&1; then
  echo "já existe '$PASS_ENTRY' no pass. Remova ou mude AI_SECRETS_PASS_ENTRY" >&2
  echo "antes de inicializar, para não sobrescrever chave de outro cofre." >&2
  exit 1
fi

resguardo="$(mktemp)" || exit 1
chmod 600 "$resguardo"

echo "inicializando o Vault (3 chaves, 2 necessárias para destravar)..."
if ! api PUT /v1/sys/init '{"secret_shares":3,"secret_threshold":2}' > "$resguardo" 2>/dev/null \
   || ! jq -e '.keys_base64 and .root_token' "$resguardo" >/dev/null 2>&1; then
  rm -f "$resguardo"
  echo "falha ao inicializar. O Vault respondeu algo inesperado." >&2
  exit 1
fi

echo "guardando as chaves no pass (o GPG vai pedir sua senha)..."
if ! pass insert -m -f "$PASS_ENTRY" < "$resguardo" >/dev/null 2>&1; then
  cat >&2 <<EOF

FALHA AO GRAVAR NO PASS — e o Vault JÁ FOI INICIALIZADO.

As chaves estão em:   $resguardo   (permissão 600)

GUARDE ESSE CONTEÚDO AGORA, em local seguro, antes de qualquer outra coisa.
Sem ele o cofre é irrecuperável. Depois de guardar:

    pass insert -m $PASS_ENTRY < $resguardo && shred -u $resguardo
EOF
  exit 1
fi

# Ler de volta é o que prova que a gravação funcionou. Sem esta conferência,
# um pass que "não deu erro" mas gravou vazio passaria despercebido até o dia
# em que você precisasse destravar.
if ! pass show "$PASS_ENTRY" 2>/dev/null | jq -e '.keys_base64 and .root_token' >/dev/null 2>&1; then
  cat >&2 <<EOF

O pass aceitou a gravação mas a LEITURA DE VOLTA não confere.

As chaves seguem em:  $resguardo   (permissão 600)
Guarde esse conteúdo antes de continuar. Não apague esse arquivo.
EOF
  exit 1
fi

# Só aqui é seguro apagar: o pass leu de volta e conferiu.
if command -v shred >/dev/null 2>&1; then shred -u "$resguardo" 2>/dev/null; else rm -f "$resguardo"; fi

cat <<EOF

Vault inicializado. Chaves guardadas em '$PASS_ENTRY', cifradas pela sua chave GPG.

Próximo passo:  secrets/vault-unseal
EOF
