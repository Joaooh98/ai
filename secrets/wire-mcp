#!/usr/bin/env bash
# Religa servidores MCP para pegarem a credencial do Vault em vez de um arquivo.
#
#   secrets/wire-mcp                        mostra o que faria (padrão)
#   secrets/wire-mcp --apply                aplica
#   secrets/wire-mcp --revert --apply       desfaz
#   secrets/wire-mcp --servers '^hostinger-' --vault-path hostinger
#
# Reescreve cada servidor escolhido para:
#     command = secrets/with-secrets
#     args    = [<caminho-no-vault>, --, <comando original>, <args originais>]
#
# Assim a credencial vive só no processo do servidor MCP. Não fica em
# ~/.claude.json, não fica em .env, e não entra no ambiente da sessão.
#
# ---------------------------------------------------------------------------
# `--dry-run` é o padrão porque isto altera CONFIGURAÇÃO DE ESCOPO DE USUÁRIO
# (~/.claude.json), que vale para todos os seus projetos e não está sob git.
# Nada muda sem você ver o diff e pedir --apply. Sempre faz backup datado antes.
# ---------------------------------------------------------------------------

set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
WRAPPER="$SELF_DIR/with-secrets"

ALVO="${CLAUDE_CONFIG:-$HOME/.claude.json}"
PADRAO='^hostinger-'
VAULT_PATH='hostinger'
APLICAR=0
REVERTER=0

while [ $# -gt 0 ]; do
  case "$1" in
    --apply)       APLICAR=1 ;;
    --revert)      REVERTER=1 ;;
    --servers)     PADRAO="${2:-}"; shift ;;
    --vault-path)  VAULT_PATH="${2:-}"; shift ;;
    --config)      ALVO="${2:-}"; shift ;;
    -h|--help)     sed -n '2,18p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "opção desconhecida: $1" >&2; exit 2 ;;
  esac
  shift
done

command -v jq >/dev/null 2>&1 || { echo "jq é necessário." >&2; exit 1; }
[ -f "$ALVO" ] || { echo "config não encontrada: $ALVO" >&2; exit 1; }
[ -x "$WRAPPER" ] || { echo "wrapper não executável: $WRAPPER" >&2; exit 1; }

# ------------------------------------------------------------------- o que muda
if [ "$REVERTER" -eq 1 ]; then
  filtro='
    .mcpServers |= with_entries(
      if (.key | test($padrao)) and ((.value.command // "") == $wrapper)
      then .value.args as $a
         | .value.command = ($a[2] // .value.command)
         | .value.args = ($a[3:] // [])
      else . end)'
else
  filtro='
    .mcpServers |= with_entries(
      if (.key | test($padrao)) and ((.value.command // "") != $wrapper)
      then .value.args = ([$vp, "--", (.value.command // "")] + (.value.args // []))
         | .value.command = $wrapper
      else . end)'
fi

antes="$(jq -r --arg padrao "$PADRAO" \
  '[.mcpServers // {} | to_entries[] | select(.key | test($padrao))
    | "  \(.key):\n      command = \(.value.command // "?")\n      args    = \((.value.args // []) | join(" "))"] | join("\n")' \
  "$ALVO" 2>/dev/null)"

if [ -z "$antes" ]; then
  echo "nenhum servidor MCP casa com '$PADRAO' em $ALVO" >&2
  exit 1
fi

depois="$(jq -r --arg padrao "$PADRAO" --arg wrapper "$WRAPPER" --arg vp "$VAULT_PATH" \
  "$filtro"' | [.mcpServers // {} | to_entries[] | select(.key | test($padrao))
    | "  \(.key):\n      command = \(.value.command // "?")\n      args    = \((.value.args // []) | join(" "))"] | join("\n")' \
  "$ALVO" 2>/dev/null)"

echo "=== ANTES ==="; printf '%s\n' "$antes"
echo; echo "=== DEPOIS ==="; printf '%s\n' "$depois"

if [ "$antes" = "$depois" ]; then
  echo; echo "nada a mudar — já está no estado pedido."
  exit 0
fi

if [ "$APLICAR" -eq 0 ]; then
  cat <<EOF

Nada foi alterado (modo padrão é só mostrar).

Antes de aplicar, garanta que o segredo está no vault:
    secrets/vault-put $VAULT_PATH APITOKEN

Depois:
    secrets/wire-mcp --apply
EOF
  exit 0
fi

backup="$ALVO.bak.$(date +%Y%m%d%H%M%S)-$$"
cp "$ALVO" "$backup" || { echo "não consegui fazer backup — abortando." >&2; exit 1; }
chmod 600 "$backup" 2>/dev/null

tmp="$(mktemp)" || exit 1
trap 'rm -f "$tmp"' EXIT

if jq --arg padrao "$PADRAO" --arg wrapper "$WRAPPER" --arg vp "$VAULT_PATH" \
     "$filtro" "$ALVO" > "$tmp" 2>/dev/null && [ -s "$tmp" ] && jq -e . "$tmp" >/dev/null 2>&1; then
  cat "$tmp" > "$ALVO"
  rm -f "$tmp"; trap - EXIT
  echo
  echo "aplicado. Backup em $backup"
  echo "Reinicie o Claude Code e confira com /mcp."
else
  echo "falha ao reescrever o JSON — $ALVO não foi alterado (backup em $backup)." >&2
  exit 1
fi
