#!/usr/bin/env bash
# Destrava o Vault e renova o token que o wrapper usa. Rode uma vez por boot.
#
#   secrets/vault-unseal
#
# O `pass show` faz o GPG abrir o popup pedindo sua senha. O gpg-agent guarda a
# senha pelo resto da sessão, então é um popup por boot, não por comando.
#
# Se você estiver sem ambiente gráfico (SSH, tty), o GPG cai para o
# pinentry-curses e pede a senha no próprio terminal.
#
# Nunca imprime chave nem token.

set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=/dev/null
. "$SELF_DIR/_lib.sh"

precisa curl
precisa jq
precisa pass

exigir_vault_de_pe

if ! vault_inicializado; then
  echo "este Vault ainda não foi inicializado. Rode: secrets/vault-init" >&2
  exit 1
fi

segredos="$(pass show "$PASS_ENTRY" 2>/dev/null)"
if [ -z "$segredos" ] || ! printf '%s' "$segredos" | jq -e '.keys_base64' >/dev/null 2>&1; then
  echo "não consegui ler '$PASS_ENTRY' do pass." >&2
  echo "  senha do GPG cancelada, ou a entrada não existe: pass ls" >&2
  exit 1
fi

# ------------------------------------------------------------------ destravar
if vault_selado; then
  echo "destravando..."
  # O limiar é 2 de 3. Alimenta uma chave por vez e para assim que abrir.
  for i in 0 1 2; do
    chave="$(printf '%s' "$segredos" | jq -r ".keys_base64[$i] // empty")"
    [ -n "$chave" ] || continue
    corpo="$(jq -n --arg k "$chave" '{key: $k}')"
    api PUT /v1/sys/unseal "$corpo" >/dev/null 2>&1
    vault_selado || break
  done
  unset chave corpo

  if vault_selado; then
    echo "ainda lacrado depois de tentar as chaves — verifique a entrada do pass." >&2
    exit 1
  fi
  echo "  destravado."
else
  echo "já estava destravado."
fi

root="$(printf '%s' "$segredos" | jq -r '.root_token')"
unset segredos

# ------------------------------------------------------------- preparar (idempotente)
# kv v2 não vem habilitado em modo produção; em dev vem, e é por isso que muito
# tutorial não menciona este passo.
if ! api GET /v1/sys/mounts '' "$root" 2>/dev/null | jq -e --arg m "$KV_MOUNT/" '.data[$m] // .[$m]' >/dev/null 2>&1; then
  echo "habilitando o depósito kv v2 em '$KV_MOUNT/'..."
  api POST "/v1/sys/mounts/$KV_MOUNT" '{"type":"kv","options":{"version":"2"}}' "$root" >/dev/null 2>&1
fi

# A política do wrapper é SÓ LEITURA. O token que vai para o disco não consegue
# escrever, apagar nem listar política — se ele vazar, o estrago é limitado a
# ler o que já existe, e não a apagar o cofre.
politica="path \"$KV_MOUNT/data/*\" { capabilities = [\"read\"] }
path \"$KV_MOUNT/metadata/*\" { capabilities = [\"list\", \"read\"] }"
corpo_pol="$(jq -n --arg p "$politica" '{policy: $p}')"
api PUT /v1/sys/policies/acl/ai-secrets-read "$corpo_pol" "$root" >/dev/null 2>&1

# --------------------------------------------------------------- token do wrapper
resp="$(api POST /v1/auth/token/create \
  '{"policies":["ai-secrets-read"],"ttl":"720h","renewable":true,"display_name":"ai-secrets-wrapper","no_default_policy":true}' \
  "$root" 2>/dev/null)"
tok="$(printf '%s' "$resp" | jq -r '.auth.client_token // empty')"
unset resp root

if [ -z "$tok" ]; then
  echo "não consegui criar o token do wrapper." >&2
  exit 1
fi

gravar_token "$tok"
unset tok

cat <<EOF
  token do wrapper renovado em $TOKEN_FILE (permissão 600, só leitura, 30 dias)

Vault pronto. Para guardar um segredo:
  secrets/vault-put hostinger APITOKEN
  ou pela interface: $VAULT_ADDR/ui   (token de login: pass show $PASS_ENTRY)
EOF
