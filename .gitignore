# Links simbólicos gerados por agents/install.sh (apontam para caminhos absolutos
# da máquina local). As fontes versionadas são agents/, skills/ e workflow/hooks/.
.claude/agents/
.claude/skills/
.claude/commands/

# Âncora do toolkit — link para a raiz deste repo, recriado por install.sh
.claude/ai-toolkit

# Cadastro de projetos do operador: caminhos absolutos desta máquina.
# Só o modelo é versionado. Detalhes em workspace/README.md.
workspace/projects/*.md
!workspace/projects/_template.md

# Logs operacionais dos hooks
.claude/logs/

# Configuração pessoal — a do time é .claude/settings.json, versionada
.claude/settings.local.json

# .mcp.json NÃO está ignorado: é escopo de projeto e deve ser versionado quando
# existir, para quem clonar o repositório receber os mesmos servidores.

# Backups que os scripts fazem antes de alterar configuração que não é deles
# (wire-mcp em ~/.claude.json, restrict.sh em settings.local.json). Ficam ao lado
# do original, e o original pode estar aqui dentro.
*.bak.[0-9]*

# Nada de estado do vault no repositório. O storage mora num volume do Docker e
# o token do wrapper em ~/.config/ai-secrets/ — de propósito, para não existir
# caminho em que um segredo caia numa árvore versionada por descuido.
secrets/.vault-token
secrets/*.local
secrets/vault-data/
